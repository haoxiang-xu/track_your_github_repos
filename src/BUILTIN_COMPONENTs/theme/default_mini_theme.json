{
  "light_mode": {
    "icon": { "color": "#222222" },
    "switch": {
      "transition": "left 0.2s cubic-bezier(0.4, 0, 0.2, 1.32), background-color 0.12s ease",
      "position": "relative",
      "height": 32,
      "width": 64,
      "backgroundColor": "#CCCCCC",
      "backgroundColor_on": "#65C467",
      "borderRadius": 20,
      "color": "#FFFFFF",
      "boxShadow": "inset 0 2px 3px rgba(0, 0, 0, 0.16)",
      "cursor": "pointer"
    },
    "button": {
      "position": "relative",
      "display": "inline-block",
      "alignItems": "center",
      "justifyContent": "center",
      "flexDirection": "column",
      "backgroundColor": "#1876D2",
      "color": "#FFFFFF",
      "borderRadius": 12,
      "border": "1px solid #CCCCCC",
      "boxShadow": "0 2px 3px rgba(0, 0, 0, 0.16)",
      "padding": "8px",
      "cursor": "pointer"
    },
    "font": {
      "color": "#222222"
    },
    "spinner": {
      "color": "#F4B6A6"
    },
    "backgroundColor": "#FFFFFF",
    "foregroundColor": "#CCCCCC",
    "scrollingSpace": {
      "backgroundColor": {
        "default": "#CCCCCCA3",
        "active": "#CCCCCC"
      },
      "border": "1px solid #CCCCCC00"
    }
  },
  "dark_mode": {
    "icon": { "color": "#CCCCCC" },
    "switch": {
      "transition": "left 0.2s cubic-bezier(0.4, 0, 0.2, 1.32), background-color 0.12s ease",
      "position": "relative",
      "height": 32,
      "width": 64,
      "backgroundColor": "#494949",
      "backgroundColor_on": "#65C467",
      "borderRadius": 20,
      "color": "#222222",
      "boxShadow": "inset 0 2px 3px rgba(0, 0, 0, 0.16)",
      "cursor": "pointer"
    },
    "button": {
      "position": "relative",
      "display": "inline-block",
      "alignItems": "center",
      "justifyContent": "center",
      "flexDirection": "column",
      "backgroundColor": "rgba(255, 255, 255, 0.16)",
      "backdropFilter": "blur(8px)",
      "color": "#FFFFFF",
      "borderRadius": 10,
      "boxShadow": "0 4px 16px rgba(0, 0, 0, 0.32)",
      "padding": "8px",
      "cursor": "pointer"
    },
    "font": {
      "color": "#FFFFFF"
    },
    "spinner": {
      "color": "#F4B6A6"
    },
    "backgroundColor": "#121212",
    "foregroundColor": "#1E1E1E",
    "scrollingSpace": {
      "backgroundColor": {
        "default": "#747880A3",
        "active": "#747880"
      },
      "border": "1px solid #89899600"
    }
  }
}
