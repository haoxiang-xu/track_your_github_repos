{
  "light_mode": {
    "icon": { "color": "#222222" },
    "switch": {
      "transition": "left 0.2s cubic-bezier(0.4, 0, 0.2, 1.32), width 0.2s cubic-bezier(0.4, 0, 0.2, 1.32), height 0.2s cubic-bezier(0.4, 0, 0.2, 1.32), background-color 0.12s ease",
      "position": "relative",
      "height": 32,
      "width": 64,
      "backgroundColor": "#CCCCCC",
      "backgroundColor_on": "#65C467",
      "borderRadius": 20,
      "color": "#FFFFFF",
      "boxShadow": "inset 0 2px 3px rgba(0, 0, 0, 0.16)",
      "cursor": "pointer"
    },
    "font": {
      "fontFamily": "Jost",
      "color": "#222222"
    },
    "spinner": {
      "color": "#F4B6A6"
    },
    "color": "#222222",
    "backgroundColor": "#FFFFFF",
    "foregroundColor": "#CCCCCC",
    "scrollingSpace": {
      "backgroundColor": {
        "default": "#CCCCCCA3",
        "active": "#CCCCCC"
      },
      "border": "1px solid #CCCCCC00"
    },
    "input": {
      "fontSize": 16,
      "borderRadius": 7,
      "backgroundColor": "#CCCCCC",
      "boxShadow": "inset 0 2px 3px rgba(0, 0, 0, 0.16)",
      "outline": { "onBlur": "2px solid rgba(0, 0, 0, 0)", "onFocus": "2px solid rgba(10, 133, 255, 1)" }
    }
  },
  "dark_mode": {
    "icon": { "color": "#CCCCCC" },
    "switch": {
      "transition": "left 0.2s cubic-bezier(0.4, 0, 0.2, 1.32), width 0.2s cubic-bezier(0.4, 0, 0.2, 1.32), height 0.2s cubic-bezier(0.4, 0, 0.2, 1.32),background-color 0.12s ease",
      "position": "relative",
      "height": 32,
      "width": 64,
      "backgroundColor": "#494949",
      "backgroundColor_on": "#65C467",
      "borderRadius": 20,
      "color": "#222222",
      "boxShadow": "inset 0 2px 3px rgba(0, 0, 0, 0.16)",
      "cursor": "pointer"
    },
    "font": {
      "fontFamily": "Jost",
      "color": "#FFFFFF"
    },
    "spinner": {
      "color": "#F4B6A6"
    },
    "color": "#CCCCCC",
    "backgroundColor": "#121212",
    "foregroundColor": "#1E1E1E",
    "scrollingSpace": {
      "backgroundColor": {
        "default": "#747880A3",
        "active": "#747880"
      },
      "border": "1px solid #89899600"
    },
    "input": {
      "fontSize": 16,
      "borderRadius": 7,
      "backgroundColor": "#494949",
      "boxShadow": "inset 0 2px 3px rgba(0, 0, 0, 0.16)",
      "outline": { "onBlur": "2px solid rgba(0, 0, 0, 0)", "onFocus": "2px solid rgba(10, 133, 255, 1)" }
    }
  }
}
