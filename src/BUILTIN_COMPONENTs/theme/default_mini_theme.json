{
  "light_mode": {
    "icon": { "color": "#222222" },
    "switch": {
      "transition": "left 0.2s cubic-bezier(0.4, 0, 0.2, 1.32), width 0.2s cubic-bezier(0.4, 0, 0.2, 1.32), height 0.2s cubic-bezier(0.4, 0, 0.2, 1.32), background-color 0.12s ease",
      "position": "relative",
      "height": 32,
      "width": 64,
      "backgroundColor": "#CCCCCC",
      "backgroundColor_on": "#65C467",
      "borderRadius": 20,
      "color": "#FFFFFF",
      "boxShadow": "inset 0 2px 3px rgba(0, 0, 0, 0.16)",
      "cursor": "pointer"
    },
    "font": {
      "fontFamily": "Jost",
      "fontSize": 14,
      "color": "#222222"
    },
    "spinner": {
      "color": "#59A2CC"
    },
    "color": "#222222",
    "backgroundColor": "#FFFFFF",
    "foregroundColor": "#CCCCCC",
    "scrolling_bar": {
      "backgroundColor": {
        "default": "#CCCCCCA3",
        "active": "#CCCCCC"
      },
      "border": "1px solid #CCCCCC00"
    },
    "input": {
      "fontSize": 16,
      "borderRadius": 7,
      "backgroundColor": "#E8E8E8",
      "boxShadow": "inset 0 2px 3px rgba(0, 0, 0, 0.08)",
      "outline": {
        "onBlur": "2px solid rgba(0, 0, 0, 0)",
        "onFocus": "2px solid rgba(10, 133, 255, 1)"
      }
    },
    "select": {
      "fontSize": 16,
      "borderRadius": 7,
      "backgroundColor": "#E8E8E8",
      "boxShadow": "inset 0 2px 3px rgba(0, 0, 0, 0.08)",
      "outline": {
        "onBlur": "2px solid rgba(0, 0, 0, 0)",
        "onFocus": "2px solid rgba(10, 133, 255, 1)"
      },
      "placeholderColor": "rgba(0, 0, 0, 0.45)",
      "dropdown": {
        "backgroundColor": "#FFFFFF",
        "boxShadow": "0 12px 20px rgba(0, 0, 0, 0.12)",
        "borderRadius": 10,
        "padding": 6,
        "maxHeight": "auto"
      },
      "option": {
        "height": 36,
        "padding": "6px 10px",
        "gap": 8,
        "hoverBackgroundColor": "rgba(0, 0, 0, 0.06)",
        "selectedBackgroundColor": "rgba(10, 133, 255, 0.14)",
        "disabledColor": "rgba(0, 0, 0, 0.35)"
      },
      "search": {
        "backgroundColor": "rgba(0, 0, 0, 0.05)",
        "borderRadius": 7,
        "padding": "6px 10px"
      }
    },
    "tooltip": {
      "color": "#FFFFFF",
      "backgroundColor": "rgba(20, 20, 20, 0.92)",
      "boxShadow": "0 6px 14px rgba(0, 0, 0, 0.28)"
    },
    "markdown": {
      "fontFamily": "NunitoSans",
      "fontSize": 16,
      "lineHeight": 1.6,
      "color": "#222222",
      "backgroundColor": "transparent",
      "blockGap": 12,
      "paragraphMargin": "0 0 0 0",
      "heading": {
        "h1": { "fontSize": 28, "fontWeight": 700, "margin": "1.2em 0 0.4em" },
        "h2": { "fontSize": 24, "fontWeight": 700, "margin": "1.1em 0 0.35em" },
        "h3": { "fontSize": 20, "fontWeight": 600, "margin": "1.0em 0 0.3em" },
        "h4": { "fontSize": 18, "fontWeight": 600, "margin": "0.9em 0 0.3em" }
      },
      "list": {
        "paddingLeft": 24,
        "margin": "0.85em 0",
        "itemMargin": "0.25em 0"
      },
      "blockquote": {
        "borderColor": "#E0E0E0",
        "color": "#555555",
        "paddingLeft": 12,
        "margin": "0.85em 0"
      },
      "code": {
        "fontFamily": "Menlo, Monaco, Consolas, monospace",
        "fontSize": 14,
        "backgroundColor": "#F6F6F6",
        "padding": "2px 4px",
        "boxShadow": "inset 0 2px 6px rgba(0, 0, 0, 0.08)",
        "borderRadius": 7
      },
      "pre": {
        "backgroundColor": "#F6F6F6",
        "padding": 12,
        "borderRadius": 7,
        "overflow": "auto",
        "margin": "0.85em"
      },
      "codeBlock": {
        "headerBackground": "#EFEFEF",
        "headerBorderColor": "#E0E0E0",
        "headerPadding": "6px 10px",
        "headerFontSize": 12,
        "labelColor": "#666666",
        "buttonColor": "#666666",
        "buttonBackground": "transparent",
        "buttonBorder": "1px solid transparent",
        "buttonBorderRadius": 7,
        "buttonPadding": "2px 6px",
        "buttonFontSize": 14
      },
      "link": {
        "color": "#0B5FFF",
        "underline": "none"
      },
      "hr": {
        "borderColor": "#E0E0E0",
        "margin": "1.2em 0"
      },
      "table": {
        "borderColor": "#E0E0E0",
        "headerBackground": "#F7F7F7",
        "cellPadding": "6px 10px",
        "margin": "0.85em 0"
      },
      "image": {
        "borderRadius": 7,
        "maxWidth": "100%"
      }
    }
  },
